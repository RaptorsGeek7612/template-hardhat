{
    "name": "voting-project",
    "version": "1.0.0",
    "description": "Voting smart contract using Hardhat 3 and OpenZeppelin.",
    "type": "module",
    "scripts": {
        "compile": "hardhat compile",
        "test": "hardhat test",
        "clean": "hardhat clean",
        "node": "hardhat node",
        "format": "prettier --write .",
        "lint": "solhint \"contracts/**/*.sol\"",
        "check": "npm run lint && npm run compile && npm test",
        "clean-install": "rm -rf node_modules package-lock.json && npm install"
    },
    "keywords": [
        "solidity",
        "hardhat",
        "ethereum",
        "web3",
        "alyra"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@openzeppelin/contracts": "^5.6.1",
        "dotenv": "^17.4.2"
    },
    "devDependencies": {
        "@nomicfoundation/hardhat-ethers": "^4.0.13",
        "@nomicfoundation/hardhat-ignition": "^3.1.7",
        "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
        "@types/chai": "^5.2.3",
        "@types/chai-as-promised": "^8.0.2",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.20.0",
        "chai": "^6.2.2",
        "ethers": "^6.17.0",
        "hardhat": "^3.9.0",
        "mocha": "^11.7.6",
        "prettier": "^3.9.0",
        "prettier-plugin-solidity": "^2.3.1",
        "solhint": "^6.2.3",
        "typescript": "~6.0.3"
    }
